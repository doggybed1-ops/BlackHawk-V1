    end
    local node=model
    for depth=1,3 do
        if not node or node==workspace then break end
        local named=Players:FindFirstChild(node.Name)
        if named and named:IsA('Player') then return named end
        for _,key in ipairs({'UserId','PlayerUserId','OwnerUserId','PlayerName','Username','Player','Owner'}) do
            local result=match(node:GetAttribute(key))
            if result then return result end
            local value=node:FindFirstChild(key)
            if value and (value:IsA('ObjectValue') or value:IsA('StringValue') or value:IsA('IntValue') or value:IsA('NumberValue')) then
