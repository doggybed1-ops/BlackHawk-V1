local function loadProfile(encoded)
    assert(type(encoded)=='string' and #encoded<=100000,'Config is missing or too large.')
    local decoded=json:JSONDecode(encoded)
    assert(type(decoded)=='table' and decoded.version==1 and type(decoded.settings)=='table','Unsupported config format.')
    local nextSettings=table.clone(defaults)
    for key,value in pairs(decoded.settings) do
        if defaults[key]~=nil then
            assert(type(value)==type(defaults[key]),'Wrong type for '..key)
            if type(value)=='number' then
                assert(value==value and math.abs(value)<math.huge,'Invalid number for '..key)
                local bounds=settingBounds[key]
                if bounds then assert(value>=bounds[1] and value<=bounds[2],'Out-of-range '..key) end
            elseif key:match('Bind$') then assert(value=='None' or (value~='RightShift' and value~='Unknown' and Enum.KeyCode[value]~=nil),'Invalid keybind for '..key)
            elseif key:match('Color$') then assert(value:match('^#%x%x%x%x%x%x$'),'Invalid color for '..key)
            elseif key=='TracerScope' then assert(value=='My shots' or value=='All received shots','Invalid tracer scope')
            elseif key=='TracerAnimation' then assert(value=='Travel' or value=='Pulse' or value=='Fade' or value=='Lightning','Invalid tracer animation')
            elseif key=='FarmMethod' then assert(value=='Supply' or value=='NPC takedowns','Invalid farm method')
            elseif key=='Part' then assert(value=='Head' or value=='Torso','Invalid target part')
            elseif key=='ESPStyle' then assert(value=='Outline' or value=='Skeleton' or value=='Both','Invalid ESP style') end
            nextSettings[key]=value
        end
    end
    local assigned={}
    for key,value in pairs(nextSettings) do if key:match('Bind$') and value~='None' then assert(not assigned[value],'Duplicate keybind: '..value);assigned[value]=true end end
    -- Validate every field before applying any change.
    for key in pairs(retired) do nextSettings[key]=false end
    releaseCamera(); locked=nil
    for key,value in pairs(nextSettings) do cfg[key]=value end
    for _,paint in pairs(refreshControls) do paint() end
    weaponChanged()
end
