local function radius(camera)
    local zoom=cfg.ZoomFOV and math.tan(math.rad(70)/2)/math.tan(math.rad(camera.FieldOfView)/2) or 1
    return math.clamp(cfg.FOV*zoom,10,2000)
end
local function eligible(m,camera,retained)
    if not valid(m) or not aimAllowed(m) then return nil,'invalid or filtered' end
    local p=partFor(m)
    if not p then return nil,'no target part' end
    local delta=positionOf(p)-camera.CFrame.Position
    if delta.Magnitude>cfg.Distance then return nil,'outside distance' end
    local screen,visible=camera:WorldToViewportPoint(positionOf(p))
    if not visible and not retained then return nil,'off screen' end
    local distance=(Vector2.new(screen.X,screen.Y)-camera.ViewportSize/2).Magnitude
    if distance>radius(camera) and not retained then return nil,'outside aim circle' end
    if cfg.Walls then
        local params=RaycastParams.new()
        params.FilterType=Enum.RaycastFilterType.Exclude
        local exclude={camera}
        local localA=localActor()
        if localA and localA.Character then table.insert(exclude,localA.Character)
        elseif me.Character then table.insert(exclude,me.Character) end
        params.FilterDescendantsInstances=exclude
        local hit=workspace:Raycast(camera.CFrame.Position,delta,params)
        if hit and not hit.Instance:IsDescendantOf(m) then return nil,'blocked by wall' end
    end
    return p,distance
end
