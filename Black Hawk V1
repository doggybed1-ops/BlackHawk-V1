local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer

-- Your API endpoint.
-- Example:
-- https://your-domain.com/verify
local VERIFY_URL = "http://78.154.103.49:10619/verify"

-- Optional Discord invite for obtaining a key.
local DISCORD_INVITE = "https://discord.gg/nsSppfHHfx"

local function getRequestFunction()
    return request
        or http_request
        or (syn and syn.request)
end

local function getHWID()
    -- Use the executor's HWID when available.
    if type(gethwid) == "function" then
        local ok, value = pcall(gethwid)
        if ok and value and tostring(value) ~= "" then
            return tostring(value)
        end
    end

    -- Fallback to Roblox's client identifier.
    local ok, value = pcall(function()
        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)

    if ok and value and tostring(value) ~= "" then
        return tostring(value)
    end

    return nil
end

local function verifyKey(key)
    key = tostring(key or ""):gsub("^%s+", ""):gsub("%s+$", "")

    if key == "" then
        return false, "Enter a key."
    end

    local hwid = getHWID()

    if not hwid then
        return false, "Unable to identify this device."
    end

    local req = getRequestFunction()

    if type(req) ~= "function" then
        return false, "HTTP request function unavailable."
    end

    local body = HttpService:JSONEncode({
        key = key,
        hwid = hwid
    })

    local ok, response = pcall(req, {
        Url = VERIFY_URL,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json"
        },
        Body = body
    })

    if not ok then
        return false, "Could not contact the key server."
    end

    local responseBody =
        response
        and (
            response.Body
            or response.body
        )

    if type(responseBody) ~= "string" then
        return false, "Invalid server response."
    end

    local decodedOK, decoded = pcall(function()
        return HttpService:JSONDecode(responseBody)
    end)

    if not decodedOK or type(decoded) ~= "table" then
        return false, "Invalid server response."
    end

    if decoded.status == "VALID" then
        return true, decoded
    end

    if decoded.status == "HWID_MISMATCH" then
        return false, "This key is already bound to another device."
    end

    if decoded.status == "EXPIRED" then
        return false, "This key has expired."
    end

    if decoded.status == "REVOKED" then
        return false, "This key has been revoked."
    end

    if decoded.status == "INVALID" then
        return false, "Invalid key."
    end

    return false, "Key verification failed."
end


