-- Bounded live-weapon adapter verified against the connected firearm code.
-- No catalog traversal, getgc scan, or repeated require calls.
local weaponRecords,weaponIndex,weaponCandidates,weaponTunes,weaponNotes={},{},{},{},{}
local currentRuntimeWeapon,runtimeWeaponStatus=nil,'Waiting for local weapon'
local getRuntimeContext=function() return nil,nil end
local recoilKeys={'Recoil_X','Recoil_Z','Recoil_Camera','Recoil_KickBack','Recoil_Range','RecoilForce_Impulse','RecoilForce_Tap'}
local reloadKeys={'Reload_Empty_Loaded','Reload_Empty_Ready','Reload_Partial_Loaded','Reload_Partial_Ready','Reload_Empty_Chamber','Reload_Empty_Final','Reload_Empty_Tube','Reload_Empty_Start'}
local activeRecords={}
local animationSpeeds=setmetatable({},{__mode='k'})
local function restoreRecord(r)
    if r.applied then
        pcall(function() if rawget(r.container,r.key)==r.modified then rawset(r.container,r.key,r.original) end end)
        r.applied=false
    end
end
restoreWeapons=function()
    for _,r in ipairs(weaponRecords) do restoreRecord(r) end
    for track,speed in pairs(animationSpeeds) do pcall(function() track:AdjustSpeed(speed) end) end
    table.clear(animationSpeeds)
end
local function field(t,key,value,feature,path)
    if type(t)~='table' then return end
    weaponIndex[t]=weaponIndex[t] or {}
    local r=weaponIndex[t][key]
    if not r then
        r={container=t,key=key,original=rawget(t,key),feature=feature,path=path..'.'..key}
        weaponIndex[t][key]=r; table.insert(weaponRecords,r)
    elseif r.applied and rawget(t,key)~=r.modified then r.original=rawget(t,key) end
    r.modified=value; activeRecords[r]=true
    local ok=pcall(function() if rawget(t,key)~=value then rawset(t,key,value) end end)
    r.applied=ok
end
local function baseline(t,key)
    local r=weaponIndex[t] and weaponIndex[t][key]
    return r and r.original or rawget(t,key)
end
local function applyWeaponSettings()
    if not alive then return end
    local actor,weapon,replica=getRuntimeContext()
    currentRuntimeWeapon=weapon
    table.clear(activeRecords)
    local tunes={}
    if weapon then
        for _,model in pairs({weapon._firearm,weapon._fpFirearm,replica and replica._firearm,replica and replica._fpFirearm}) do
            if type(model)=='table' and type(model.Tune)=='table' then tunes[model.Tune]=model.Name or 'Equipped' end
        end
    end
    table.clear(weaponTunes)
    for tune,name in pairs(tunes) do
        local path='LocalEquippedWeapon.'..name..'.Tune'
        weaponTunes[path]=tune
        if cfg.ZeroRecoil then
            for _,key in ipairs(recoilKeys) do
                local v=rawget(tune,key)
                if type(v)=='number' then field(tune,key,0,'ZeroRecoil',path)
                elseif typeof(v)=='Vector2' then field(tune,key,Vector2.new(0,0),'ZeroRecoil',path)
                elseif typeof(v)=='Vector3' then field(tune,key,Vector3.new(0,0,0),'ZeroRecoil',path) end
            end
        end
        if cfg.ZeroSpread then field(tune,'Barrel_Spread',0,'ZeroSpread',path) end
        if cfg.FastFire and type(baseline(tune,'RPM'))=='number' then field(tune,'RPM',baseline(tune,'RPM')*cfg.FireMultiplier,'FastFire',path) end
        if cfg.InstantADS then field(tune,'ADS_Speed',1000,'InstantADS',path) end
        if cfg.FastReload or cfg.InstantReload then
            for _,key in ipairs(reloadKeys) do
                local original=baseline(tune,key)
                if type(original)=='number' and original>0 then
                    field(tune,key,cfg.InstantReload and .01 or math.max(.01,original/cfg.ReloadSpeed),'Reload',path)
                end
            end
        end
    end
    if cfg.InstantADS and actor and type(actor.ViewModel)=='table' then field(actor.ViewModel,'ADSSpeed',1000,'InstantADS','LocalViewModel') end
    if cfg.MeleeReach and weapon and type(rawget(weapon,'_distance'))=='number' and rawget(weapon,'_timer') then
        field(weapon,'_distance',cfg.Reach,'MeleeReach','EquippedMelee')
    end
    if cfg.FastMelee and weapon and type(rawget(weapon,'_timer'))=='number' then
        field(weapon,'_timer',.05,'FastMelee','EquippedMelee')
        if type(rawget(weapon,'_delay'))=='number' then field(weapon,'_delay',.01,'FastMelee','EquippedMelee') end
    end
    for i=#weaponRecords,1,-1 do
        local r=weaponRecords[i]
        if not activeRecords[r] then
            restoreRecord(r); weaponIndex[r.container][r.key]=nil
            if next(weaponIndex[r.container])==nil then weaponIndex[r.container]=nil end
            table.remove(weaponRecords,i)
        end
    end
    local tracks={}
    if cfg.FastReload then
        for _,handler in pairs({weapon,replica}) do
