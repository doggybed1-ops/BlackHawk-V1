-- Exact critically damped angular spring: velocity changes continuously when
-- the target moves. Wrapping yaw avoids long spins across the +/- pi boundary.
local function springAngle(current,target,velocity,frequency,dt)
    local error=(current-target+math.pi)%(2*math.pi)-math.pi
    local j=velocity+frequency*error
    local decay=math.exp(-frequency*dt)
    return target+(error+j*dt)*decay,(velocity-frequency*j*dt)*decay
end
