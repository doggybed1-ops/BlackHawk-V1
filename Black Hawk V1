        value.Text=(step<1 and string.format('%.2f',cfg[key]) or tostring(cfg[key]))..unit
    end
    local function update(x)
        if track.AbsoluteSize.X<=0 then return end
        local ratio=math.clamp((x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
        cfg[key]=math.clamp(minimum+math.floor(ratio*(maximum-minimum)/step+.5)*step,minimum,maximum)
        paint()
    end
    refreshControls[key]=paint
    paint()
    on(hit.InputBegan,function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            draggingSlider={update=update,input=input,touch=input.UserInputType==Enum.UserInputType.Touch}; update(input.Position.X)
