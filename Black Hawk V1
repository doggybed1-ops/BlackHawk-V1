local function requireValidKey()

    local gui, keyBox, verifyButton, discordButton, status =
        createKeyGate()

    local verified = false

    local function finish()
        verified = true

        if gui then
            gui:Destroy()
        end
    end

    verifyButton.Activated:Connect(function()

        if verified then
            return
        end

        verifyButton.Text = "VERIFYING..."
        status.TextColor3 = Color3.fromRGB(190, 190, 200)
        status.Text = "Contacting key server..."

        local success, result = verifyKey(keyBox.Text)

        if success then

            status.TextColor3 = Color3.fromRGB(150, 240, 160)

            if result.expires_at then
                status.Text = "Key verified."
            else
                status.Text = "Lifetime key verified."
            end

            task.wait(0.35)

            finish()

        else

            verifyButton.Text = "VERIFY KEY"
            status.TextColor3 = Color3.fromRGB(255, 120, 140)
            status.Text = tostring(result)
        end
    end)

    discordButton.Activated:Connect(function()

        local req = getRequestFunction()

        if type(req) == "function" then
            pcall(req, {
                Url = DISCORD_INVITE,
                Method = "GET"
            })
        end

        if setclipboard then
            pcall(setclipboard, DISCORD_INVITE)
            status.TextColor3 = Color3.fromRGB(180, 190, 220)
            status.Text = "Discord invite copied."
        else
            status.Text = DISCORD_INVITE
        end
    end)

    repeat
        task.wait()
    until verified
end


